server {
    listen       8080;
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    # Cache static build assets
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Proxy RabbitMQ API calls
    location /api/ {
        # IMPORTANT: no URI part after the upstream URL. With a URI (e.g. ".../api/"),
        # nginx normalizes the path and decodes %2F to "/", which breaks every
        # RabbitMQ endpoint containing the default vhost ("/" -> %2F).
        # Without a URI, the original request URI is forwarded untouched.
        proxy_pass ${RABBITMQ_URL};
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Suppress RabbitMQ WWW-Authenticate header to prevent native browser login prompts on 401
        proxy_hide_header WWW-Authenticate;

        proxy_buffering off;
        proxy_read_timeout 60s;
    }

    # SPA routing fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}
